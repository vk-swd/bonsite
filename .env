# OTHER ENV VARS
WORKDIR="/work_dirrrrr1"
SOURCEDIR="/src"
SHARED_DIR="/shared"
COMMON_DIR_NAME="common"
HEALTHCHECK_PORT=8080
DB_INITIALIZER_NAME="db_initializer"
DOCS_PORT=3002
TESTER_NAME="tester"

# GENERATOR ENV VARS
GENERATOR_NAME="generator"
GENERATOR_HOST_NAME=${GENERATOR_NAME}
GENERATOR_PORT="4000"

# COMMON ENV VARS
MONITORING_PORT=3000
LOG_MOUNT="/logmount"

#MESSAGE SINK ENV VARS
MESSAGE_SINK_NAME="message_sink"
MESSAGE_SINK_HOST_NAME=${MESSAGE_SINK_NAME}

#STATEMENT GENERATOR ENV VARS
STATEMENT_GENERATOR_NAME="statement_generator"
STATEMENT_GENERATOR_HOST_NAME=${STATEMENT_GENERATOR_NAME}
STATEMENT_GENERATOR_PORT="4001"

# GRAPH QL SERVER ENV VARS
GQL_APP_NAME="gql"
GQL_HOSTNAME=${GQL_APP_NAME}
GQL_PORT="4000"
GQL_STATEMENT_GENERATOR_HOST_NAME=${STATEMENT_GENERATOR_HOST_NAME}
GQL_STATEMENT_GENERATOR_PORT=${STATEMENT_GENERATOR_PORT}
GQL_GENERATOR_HOST_NAME=${GENERATOR_HOST_NAME}
GQL_GENERATOR_PORT=${GENERATOR_PORT}

# KAFKA_ENV_VARS
KAFKA_TOPICS_TRANSACTIONS="transactions"
KAFKA_TOPICS_TRANSACTION_RESULTS="transaction_results"
KAFKA_HOST_NAME="kafka"
KAFKA_PORT=9092
KAFKA_BROKERS="$KAFKA_HOST_NAME:$KAFKA_PORT"
KAFKA_GROUP_ID="1"
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP='CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT'
KAFKA_PROCESS_ROLES='broker,controller'
KAFKA_CONTROLLER_QUORUM_VOTERS="1@${KAFKA_HOST_NAME}:9093"
KAFKA_LISTENERS="CONTROLLER://:9093,PLAINTEXT://:${KAFKA_PORT}"
KAFKA_INTER_BROKER_LISTENER_NAME='PLAINTEXT'
KAFKA_CONTROLLER_LISTENER_NAMES='CONTROLLER'
CLUSTER_ID='4L6g3nShT-eMCtK--X86sw'
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_LOG_CLEANER_DELETE_RETENTION_MS=5000
KAFKA_LOG_LOCAL_RETENTION_BYTES=100000000
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=15000
KAFKA_TRANSACTION_STATE_LOG_SEGMENT_BYTES=10000000
KAFKA_LOG_SEGMENT_BYTES=10000000
KAFKA_LOG_DIRS='/tmp/kraft-combined-logs'
KAFKA_NODE_ID=1
KAFKA_ADVERTISED_LISTENERS="PLAINTEXT://${KAFKA_HOST_NAME}:${KAFKA_PORT}"

#MSSQL ENV VARS
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=${MSSQL_PASSWORD:?}
MSSQL_PASSWORD=${MSSQL_PASSWORD:?}
MSSQL_HOSTNAME="mssql"
MSSQL_PORT="1433"
MSSQL_SA_USERNAME="sa"
MSSQL_DB_NAME="statement_consumer_db"
MSSQL_CONSUMER_USERNAME="consumerUser"
MSSQL_STATEMENT_CREATOR_USERNAME="statementCreatorUser"

#AUTH ENV VARS
AUTH_PORT=4001
AUTH_APP_NAME="auth"
AUTH_APP_HOSTNAME=${AUTH_APP_NAME}
CLOUDFLARE_SECRET=${CLOUDFLARE_SECRET:?}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:?}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:?}

#TUNNEL CLIENT ENV VARS
TUNNEL_CLIENT_LOCAL_GQL_HOST_NAME=${GQL_HOSTNAME}
TUNNEL_CLIENT_LOCAL_GQL_PORT=${GQL_PORT}
TUNNEL_CLIENT_REMOTE_GQL_PORT="50010"
TUNNEL_CLIENT_SERVICE_NAME="tunnel_client"
TUNNEL_CLIENT_USER_NAME=${TUNNEL_CLIENT_SERVICE_NAME}
TUNNEL_CLIENT_HOST_NAME=${TUNNEL_CLIENT_SERVICE_NAME}
TUNNEL_CLIENT_KEY="/tunnelkeys/tunnel"
TUNNEL_CLIENT_SERVER_ADDR=${TUNNEL_CLIENT_SERVER_ADDR:-$TUNNEL_SERVER_HOST_NAME}
TUNNEL_CLIENT_SERVER_PORT=${TUNNEL_CLIENT_SERVER_PORT:-$TUNNEL_SERVER_EXPOSED_PORT}
TUNNEL_CLIENT_LOCAL_AUTH_MONITORING_PORT=9100
TUNNEL_CLIENT_REMOTE_AUTH_MONITORING_PORT=${MONITORING_PORT}
TUNNEL_CLIENT_REMOTE_AUTH_HOSTNAME=${AUTH_APP_HOSTNAME}
TUNNEL_CLIENT_SERVER_USER=${TUNNEL_SERVER_USER_NAME}
TUNNEL_CLIENT_PRIVATE_KEY_TO_MOUNT=${TUNNEL_CLIENT_PRIVATE_KEY_TO_MOUNT:?}
TUNNEL_CLIENT_PUBLIC_KEY_TO_MOUNT=${TUNNEL_CLIENT_PUBLIC_KEY_TO_MOUNT:?}
TUNNEL_CLIENT_MOUNTED_PRIVATE_KEY_NAME="${WORKDIR}/tunnel"
TUNNEL_CLIENT_MOUNTED_PUBLIC_KEY_NAME="${WORKDIR}/tunnel.pub"

#TUNNEL SERLVER ENV VARS
TUNNEL_SERVER_SERVICE_NAME="tunnel"
TUNNEL_SERVER_USER_NAME="sshuser"
TUNNEL_SERVER_HOST_NAME=${TUNNEL_SERVER_SERVICE_NAME}
TUNNEL_SERVER_AUTHORISED_KEY_MOUNT_PATH="/config/.ssh/mounted_pub_key.pub"
TUNNEL_SERVER_EXPOSED_PORT=2222

#NGINX ENV VARS
NGINX_GQL_HOSTNAME=${SPLIT_HOSTED:+$TUNNEL_SERVER_HOST_NAME}
NGINX_GQL_HOSTNAME=${NGINX_GQL_HOSTNAME:-$GQL_HOSTNAME}
NGINX_GQL_PORT=${SPLIT_HOSTED:+$TUNNEL_CLIENT_REMOTE_GQL_PORT}
NGINX_GQL_PORT=${NGINX_GQL_PORT:-$GQL_PORT}
NGINX_PORT=81
NGINX_FOLDER="/NGINX_FOLDER"
NGINX_ENVSUBST_TEMPLATE_DIR="/etc/nginx/template"
NGINX_ENVSUBST_TEMPLATE_SUFFIX=.template
NGINX_AUTH_PORT=${AUTH_PORT}
NGINX_AUTH_HOSTNAME=${AUTH_APP_HOSTNAME}

#PROMETHEUS ENV VARS
PROMETHEUS_NAME="prometheus"
PROMETHEUS_HOSTNAME=${PROMETHEUS_NAME}
PROMETHEUS_PORT="9090"
PROM_LOCAL_SERVICES_HOSTNAMES="$MESSAGE_SINK_NAME $GQL_APP_NAME $GENERATOR_NAME $STATEMENT_GENERATOR_NAME"
PROM_AUTH_APP_HOSTNAME=${SPLIT_HOSTED:+$TUNNEL_CLIENT_HOST_NAME}
PROM_AUTH_APP_HOSTNAME=${PROM_AUTH_APP_HOSTNAME:-$AUTH_APP_NAME}
PROM_AUTH_APP_MONITORING_PORT=${SPLIT_HOSTED:+$TUNNEL_CLIENT_LOCAL_AUTH_MONITORING_PORT}
PROM_AUTH_APP_MONITORING_PORT=${PROM_AUTH_APP_PORT:-$MONITORING_PORT}

#ENV VARS FOR GRAPHANA
GRAPHANA_HOSTNAME="graphana"
GRAPHANA_PORT=3000
GRAPHANA_EXPOSED_PORT_ADDR="127.0.0.1:3001"
GRAPHANA_DASHBOARD_FOLDER="/dashboards"
GRAPHANA_DATASOURCE_URL="http://$PROMETHEUS_HOSTNAME:$PROMETHEUS_PORT"

#TESTER ENV VARS
TESTER_GQL_HOSTNAME=${GQL_HOSTNAME}
TESTER_GQL_PORT=${GQL_PORT}
 
#SHARED ENV VARS
FRONTEND_DEPLOY_FOLDER_HOST=${FRONTEND_DEPLOY_FOLDER_HOST:?}
LOG_MOUNT_HOST=${LOG_MOUNT_HOST:?}

#FRONTEND BUILDER ENV VARS
FRONTEND_NAME=frontend
FRONTEND_DEPLOY_FOLDER=/deployed
 

